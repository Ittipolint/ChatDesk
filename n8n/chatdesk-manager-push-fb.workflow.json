                      "webhookId":  "117be6a7-0f8b-49f1-b5cb-3fb4852934de"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "/* Build Facebook Messenger Graph API payload from api/send.php body\n * body: { userId, text, type, mediaUrl, mediaPreviewUrl, stickerPackage?, stickerId? }\n */\nconst body = $(\u0027Webhook\u0027).first().json.body || {};\nconst userId = String(body.userId || \u0027\u0027).trim();\nconst type = String(body.type || \u0027text\u0027);\nif (!userId) { throw new Error(\u0027Missing userId\u0027); }\n\nlet message;\nif (type === \u0027image\u0027) {\n  const url = body.mediaUrl || \u0027\u0027;\n  if (!url) { throw new Error(\u0027Missing mediaUrl for image\u0027); }\n  message = { attachment: { type: \u0027image\u0027, payload: { url: url, is_reusable: true } } };\n} else if (type === \u0027video\u0027 || type === \u0027audio\u0027 || type === \u0027file\u0027) {\n  const url = body.mediaUrl || \u0027\u0027;\n  if (!url) { throw new Error(\u0027Missing mediaUrl for \u0027 + type); }\n  message = { attachment: { type: type, payload: { url: url } } };\n} else if (type === \u0027sticker\u0027) {\n  const url = body.mediaUrl || \u0027\u0027;\n  message = url\n    ? { attachment: { type: \u0027image\u0027, payload: { url: url, is_reusable: true } } }\n    : { text: \u0027???? (???????????????????????????)\u0027 };\n} else {\n  message = { text: String(body.text || \u0027\u0027) };\n}\n\nreturn [{ json: {\n  recipient: { id: userId },\n  message: message,\n  messaging_type: \u0027RESPONSE\u0027,\n} }];"
                                     },
                      "type":  "n8n-nodes-base.code",
